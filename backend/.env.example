ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./kosha.db
TIMEZONE=Asia/Kolkata

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_MODE=test

# AutoPay Collection Engine
AUTOPAY_COLLECTION_ENABLED=True
AUTOPAY_COLLECTION_INTERVAL_SECONDS=3600
AUTOPAY_COLLECTION_HOUR_UTC=2
AUTOPAY_MAX_RETRY_ATTEMPTS=3
PRE_DEBIT_NOTIFICATION_HOURS=24
