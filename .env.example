# ==============================================================================
# KOSHA — Predictive Cash-Flow Management Platform
# Environment Configuration Template
# ==============================================================================

# Application Runtime
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Persistence
# Default uses local zero-configuration SQLite database.
# In production, specify PostgreSQL: postgresql://user:password@localhost:5432/kosha
DATABASE_URL=sqlite:///./kosha.db

# Timezone Configuration (Financial calculations & repayment reminders evaluate in Asia/Kolkata)
TIMEZONE=Asia/Kolkata

# Payment Gateway Configuration
# Default is KOSHA_SANDBOX (transparent sandbox mode).
# For live production processing with Razorpay / Cashfree, configure real provider credentials.
# NEVER commit production secret keys to version control.
PAYMENT_GATEWAY_PROVIDER=KOSHA_SANDBOX
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME="KOSHA — Predictive Cash-Flow Early Warning"
