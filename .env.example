# ==============================================================================
# KOSHA — Predictive Cash-Flow Management Platform
# Environment Configuration Template
# ==============================================================================

# Application Runtime
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Persistence
# Default uses local zero-configuration SQLite database.
# In production, specify PostgreSQL: postgresql://user:password@localhost:5432/kosha
DATABASE_URL=sqlite:///./kosha.db

# Timezone Configuration (Financial calculations & repayment reminders evaluate in Asia/Kolkata)
TIMEZONE=Asia/Kolkata

# Payment Gateway Configuration
# Default is Razorpay Test Mode with safe test credentials.
# For Test Mode: use your Razorpay Test Key ID (rzp_test_...) and Key Secret.
# For Live Mode: set RAZORPAY_MODE=live and provide real rzp_live_... credentials.
# NEVER commit production secret keys to version control.
RAZORPAY_KEY_ID=rzp_test_your_test_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_for_hmac_verification
RAZORPAY_MODE=test
RAZORPAY_UPI_FLOW=payment_link
RAZORPAY_MERCHANT_NAME=KOSHA MSME Treasury
RAZORPAY_UPI_VPA=kosha.msme@razorpay

# Legacy / Alternative gateway aliases
PAYMENT_GATEWAY_PROVIDER=RAZORPAY
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME="KOSHA — Predictive Cash-Flow Early Warning"
