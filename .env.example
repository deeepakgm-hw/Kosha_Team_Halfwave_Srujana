# KOSHA Root Environment Configuration Example
# Copy to .env or reference in respective backend/.env and frontend/.env

# Backend Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./kosha.db

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME="KOSHA — Predictive Cash-Flow Early Warning"
